igin:50%;animation:2.4s ease-in-out infinite titleHeartbeat}@keyframes titleHeartbeat{0%,20%,to{transform:scale(1);box-shadow:0 0 #4da3ff00}5%{transform:scale(1.06);box-shadow:0 0 0 3px #4da3ff59,0 0 10px 2px #4da3ff33}10%{transform:scale(1);box-shadow:0 0 #4da3ff00}25%{transform:scale(1.06);box-shadow:0 0 0 3px #4da3ff59,0 0 10px 2px #4da3ff33}30%{transform:scale(1);box-shadow:0 0 #4da3ff00}}body.light .header-title-button.attention-heartbeat{animation-name:titleHeartbeatLight}@keyframes titleHeartbeatLight{0%,20%,to{transform:scale(1);box-shadow:0 0 #0078d400}5%{transform:scale(1.06);box-shadow:0 0 0 3px #0078d447,0 0 10px 2px #0078d426}10%{transform:scale(1);box-shadow:0 0 #0078d400}25%{transform:scale(1.06);box-shadow:0 0 0 3px #0078d447,0 0 10px 2px #0078d426}30%{transform:scale(1);box-shadow:0 0 #0078d400}}.header-title-button.attention-rotate{transform-style:preserve-3d;transform-origin:50%;backface-visibility:visible;animation:6s ease-in-out infinite titleRotate}@keyframes titleRotate{0%,to{transform:rotateY(0)}45%{transform:rotateY(360deg)}}.header-title-button.attention:focus-visible{animation:none}.header-title-button.attention:focus-visible:after{opacity:0;animation:none}@media (prefers-reduced-motion:reduce){.header-title-button.attention-glow,.header-title-button.attention-breathe,.header-title-button.attention-shimmer:after,.header-title-button.attention-heartbeat,.header-title-button.attention-rotate{animation:none}.header-title-button.attention{text-underline-offset:3px;-webkit-text-decoration:underline dotted;text-decoration:underline dotted}}
